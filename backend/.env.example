# Customer 360 Intelligence Platform — example environment (design §18).
#
# Copy to `.env` and adjust. This file is committed and MUST NOT contain real values.
# AWS credentials are never listed here: they come from the default credential chain
# (instance role, SSO profile, or environment) so no secret lands in source.
#
# Every variable below is optional unless marked REQUIRED — the typed Settings model supplies the
# default shown. Invalid or missing required values fail at startup, not on first use.

# ---------------------------------------------------------------- runtime
ENVIRONMENT=local                    # local | dev | staging | prod
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                      # json | console

# ---------------------------------------------------------------- data
SQLITE_DB_PATH=data/customer.db
SQLITE_AUDIT_DB_PATH=data/audit.db
SQLITE_CHECKPOINT_DB_PATH=data/checkpoints.db
SQLITE_KNOWLEDGE_DB_PATH=data/knowledge.db
SQLITE_EVAL_DB_PATH=data/eval.db
SQLITE_SIGNALS_DB_PATH=data/signals.db
SQLITE_READ_POOL_SIZE=8
SEED_CUSTOMER_COUNT=100
SEED_RANDOM_SEED=42

# ---------------------------------------------------------------- model provider
# LLM_PROVIDER=mock runs the whole stack with no AWS account and no network calls.
LLM_PROVIDER=mock                    # bedrock | mock
AWS_REGION=us-east-1
# REQUIRED when LLM_PROVIDER=bedrock, e.g. anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIMENSIONS=1024        # 256 | 512 | 1024
BEDROCK_GUARDRAIL_ID=
BEDROCK_MAX_TOKENS=1024
BEDROCK_READ_TIMEOUT_S=8.0
BEDROCK_MAX_RETRIES=3

# ---------------------------------------------------------------- retrieval
RETRIEVAL_ENABLED=true
RETRIEVAL_LEXICAL_K=20
RETRIEVAL_SEMANTIC_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_CONTEXT_CHUNKS=5
RETRIEVAL_MIN_SCORE=0.02
RERANK_ENABLED=false
RERANK_MODEL_ID=                     # REQUIRED when RERANK_ENABLED=true
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_RATIO=0.15

# ---------------------------------------------------------------- agents
AGENT_CACHE_TTL_S=900
AGENT_WAVE1_BUDGET_S=2.5
AGENT_WAVE2_BUDGET_S=1.5
AGENT_WAVE3_BUDGET_S=1.0
QA_MAX_TOOL_CALLS=6
PROMPT_REGISTRY_PATH=prompts/

# ---------------------------------------------------------------- graph
GRAPH_MAX_HOPS=3
GRAPH_NODE_CAP=300

# ---------------------------------------------------------------- thresholds (req 13.x)
MAJOR_TXN_ABSOLUTE_THRESHOLD_CENTS=1000000
MAJOR_TXN_MEDIAN_MULTIPLE=10.0
SPEND_ANOMALY_SIGMA=2.0
OFFER_COOLING_OFF_DAYS=90

# ---------------------------------------------------------------- signals feed (Phase 17)
SIGNAL_LARGE_DEPOSIT_THRESHOLD_CENTS=5000000
SIGNAL_RANK_SEVERITY_WEIGHT=1.0
SIGNAL_RANK_VALUE_WEIGHT=0.6
SIGNAL_RANK_RECENCY_WEIGHT=0.3
SIGNAL_COOLING_OFF_DAYS=30
SIGNAL_VALUE_AT_STAKE_CAP_CENTS=100000000

# ---------------------------------------------------------------- observability
OTEL_ENABLED=true
# Use http://localhost:4317 when running the collector from docker/ outside a container network.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=c360-api
OTEL_TRACES_EXPORTER=otlp            # otlp | console | none
OTEL_METRICS_EXPORTER=otlp           # otlp | console | none
OTEL_METRIC_EXPORT_INTERVAL_MS=60000
OTEL_TRACES_SAMPLER_ARG=1.0
# Requirement 18.8: leaving this false keeps prompts and completions out of telemetry.
# Enabling it logs a startup warning and is for local debugging only.
OTEL_CAPTURE_PROMPT_CONTENT=false
# REQUIRED in staging and prod: salt for hashing customer IDs before they reach telemetry.
TELEMETRY_CUSTOMER_HASH_SALT=
COST_PRICE_TABLE_PATH=config/bedrock_prices.json

# ---------------------------------------------------------------- evaluation
EVAL_PANEL_PER_COHORT=3
EVAL_GROUNDEDNESS_MIN=1.0
EVAL_COVERAGE_MIN=0.95
EVAL_RETRIEVAL_RECALL_MIN=0.85
EVAL_REGRESSION_TOLERANCE_PTS=1.0

# ---------------------------------------------------------------- auth (req 12.x)
AUTH_PROVIDER=local                  # local | oidc
JWT_PRIVATE_KEY_PATH=                # REQUIRED when AUTH_PROVIDER=local
JWT_ACCESS_TTL_S=900
SESSION_IDLE_TIMEOUT_S=1800
OIDC_ISSUER=                         # REQUIRED when AUTH_PROVIDER=oidc
OIDC_CLIENT_ID=                      # REQUIRED when AUTH_PROVIDER=oidc
AUDIT_RETENTION_DAYS=365
