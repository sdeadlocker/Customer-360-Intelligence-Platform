{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockGenerationAndEmbeddings",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:${region}::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:${region}::foundation-model/anthropic.claude-sonnet-4-5-20250929-v1:0",
        "arn:aws:bedrock:${region}::foundation-model/amazon.titan-embed-text-v2:0",
        "arn:aws:bedrock:${region}:${account_id}:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:${region}:${account_id}:inference-profile/us.anthropic.claude-sonnet-4-5-20250929-v1:0"
      ]
    },
    {
      "Sid": "BedrockCrossRegionInferenceProfileTargets",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:us-east-2::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-sonnet-4-5-20250929-v1:0",
        "arn:aws:bedrock:us-east-2::foundation-model/anthropic.claude-sonnet-4-5-20250929-v1:0",
        "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-sonnet-4-5-20250929-v1:0"
      ]
    },
    {
      "Sid": "BedrockRerankOptional",
      "Effect": "Allow",
      "Action": [
        "bedrock:Rerank"
      ],
      "Resource": "arn:aws:bedrock:${region}::foundation-model/*"
    },
    {
      "Sid": "BedrockGuardrailOptional",
      "Effect": "Allow",
      "Action": [
        "bedrock:ApplyGuardrail"
      ],
      "Resource": "arn:aws:bedrock:${region}:${account_id}:guardrail/*"
    },
    {
      "Sid": "SecretsReadRuntimeOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:${region}:${account_id}:secret:c360/jwt-private-key-*",
        "arn:aws:secretsmanager:${region}:${account_id}:secret:c360/telemetry-hash-salt-*",
        "arn:aws:secretsmanager:${region}:${account_id}:secret:c360/oidc-*"
      ]
    },
    {
      "Sid": "ReportsAndAssetsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${reports_bucket}",
        "arn:aws:s3:::${reports_bucket}/*"
      ]
    },
    {
      "Sid": "EfsMountForWritableData",
      "Effect": "Allow",
      "Action": [
        "elasticfilesystem:ClientMount",
        "elasticfilesystem:ClientWrite",
        "elasticfilesystem:DescribeMountTargets"
      ],
      "Resource": "arn:aws:elasticfilesystem:${region}:${account_id}:file-system/${efs_id}"
    },
    {
      "Sid": "TelemetryToXRayAndCloudWatch",
      "Effect": "Allow",
      "Action": [
        "xray:PutTraceSegments",
        "xray:PutTelemetryRecords",
        "xray:GetSamplingRules",
        "xray:GetSamplingTargets",
        "cloudwatch:PutMetricData",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    }
  ]
}
